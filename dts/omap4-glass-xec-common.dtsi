// SPDX-License-Identifier: GPL-2.0-only OR MIT
/*
 * Google Glass Explorer Edition XE-C ("notle", TI OMAP4430, 2 GB): what both
 * images share. Every pad, GPIO and address names its source in Google's
 * Glass kernel 3.4.83 (GlassHack/factory-kernel@1091b53), as
 * arch/arm/mach-omap2/board-notle*.c and board-notle.h, below "notle:".
 * GPIO numbers are those of EVT2 and later boards (the XE-C is a production
 * unit); OMAP4 GPIO n is <&gpio(n/32+1) (n%32)>.
 *
 * Nothing here touches the display: the bootloader programs the iCE40 FPGA
 * (its own fpga partition) and FPGA_CRESET_B (GPIO 87), DISP_ENB (84) and
 * LCD_RST_N (94) are never named, so they keep the bootloader's state.
 */
/dts-v1/;

#include "omap443x.dtsi"

/ {
	model = "Google Glass Explorer Edition (XE-C)";
	compatible = "google,glass-xec", "ti,omap4430", "ti,omap4";

	chosen {
		stdout-path = &uart3;	/* notle: ttyO2, the debug UART */
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The display as the bootloader leaves it, a text console on it.
		 * Glass's U-Boot (XE24 bootloader.img, the routine at 0x24604)
		 * programs the iCE40 FPGA and the DISPC itself: LCD2, 640x360,
		 * hsw 68 hfp 10 hbp 10 / vsw 10 vfp 5 vbp 5 (Google's panel
		 * timings), graphics pipe ARGB32 from 0x80500000. That address lies
		 * inside the decompressed mainline kernel, so this framebuffer is
		 * elsewhere and /init points GFX_BA0/BA1 at it (with the format
		 * set to xRGB, so no alpha) before anything is drawn on it.
		 * Nothing here programs the panel or the FPGA.
		 */
		framebuffer@9c700000 {
			compatible = "simple-framebuffer";
			reg = <0x9c700000 (640 * 360 * 4)>;
			width = <640>;
			height = <360>;
			stride = <(640 * 4)>;
			format = "x8r8g8b8";
			clocks = <&l3_dss_clkctrl OMAP4_DSS_CORE_CLKCTRL 0>,
				 <&l3_dss_clkctrl OMAP4_DSS_CORE_CLKCTRL 8>;
			power-domains = <&prm_dss>;
		};
	};

	/*
	 * A placeholder: ARM_ATAG_DTB_COMPAT replaces it with the bootloader's
	 * ATAG_MEM (2 GB on XE-C, notle: Google's "Enable 2GB support").
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The secure monitor's RAM (notle: omap4_ion.h PHYS_ADDR_SMC_MEM,
		 * 0x80000000 + 1 GB - 3 MB, PHYS_ADDR_SMC_SIZE 3 MB): never touched.
		 */
		secure@bfd00000 {
			reg = <0xbfd00000 0x300000>;
			no-map;
		};

		/*
		 * Crash logs that survive a warm reset, in the region the stock
		 * kernel keeps for its RAM console (notle: omap_ram_console.h,
		 * 0x80000000 + 512 MB, 2 MB). Read after a reboot from
		 * /sys/fs/pstore.
		 */
		/*
		 * The console's framebuffer (640 x 360 x 4 = 921600 bytes), in RAM
		 * the stock kernel used as ordinary memory (its default bootargs
		 * map 456 MB from 0x80000000: up to 0x9c800000).
		 */
		framebuffer@9c700000 {
			reg = <0x9c700000 0x100000>;
			no-map;
		};

		ramoops@a0000000 {
			compatible = "ramoops";
			reg = <0xa0000000 0x200000>;
			no-map;
			record-size = <0x40000>;
			console-size = <0x100000>;
			pmsg-size = <0x40000>;
		};
	};
};

&omap4_pmx_core {
	/* Applied by the pin controller itself (no consumer). */
	pinctrl-names = "default";
	pinctrl-0 = <&usb_mux_pins>;

	uart3_pins: uart3-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x144, PIN_INPUT | MUX_MODE0)		/* uart3_rx_irrx */
			OMAP4_IOPAD(0x146, PIN_OUTPUT | MUX_MODE0)		/* uart3_tx_irtx */
		>;
	};

	i2c1_pins: i2c1-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x122, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c1_scl */
			OMAP4_IOPAD(0x124, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c1_sda */
		>;
	};

	i2c2_pins: i2c2-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x126, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c2_scl */
			OMAP4_IOPAD(0x128, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c2_sda */
		>;
	};

	i2c3_pins: i2c3-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x12a, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c3_scl */
			OMAP4_IOPAD(0x12c, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c3_sda */
		>;
	};

	i2c4_pins: i2c4-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x12e, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c4_scl */
			OMAP4_IOPAD(0x130, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c4_sda */
		>;
	};

	usb_otg_hs_pins: usb-otg-hs-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x194, PIN_OUTPUT_PULLDOWN | MUX_MODE0)	/* usba0_otg_ce */
			OMAP4_IOPAD(0x196, PIN_INPUT | MUX_MODE0)		/* usba0_otg_dp */
			OMAP4_IOPAD(0x198, PIN_INPUT | MUX_MODE0)		/* usba0_otg_dm */
		>;
	};

	/*
	 * The micro-USB connector's data lines go through a mux (notle:
	 * notle-usb-mux.c): CB1 low and CB0 high is USB, CB1 high and CB0 low
	 * the TTY (debug UART on the connector). notle: evt2_board_mux.
	 */
	usb_mux_pins: usb-mux-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x06c, PIN_OUTPUT | MUX_MODE3)		/* gpmc_a22.gpio_46: USB_MUX_CB0 */
			OMAP4_IOPAD(0x06a, PIN_OUTPUT | MUX_MODE3)		/* gpmc_a21.gpio_45: USB_MUX_CB1 */
		>;
	};
};

&gpio2 {
	/* The connector on the OMAP's USB (notle: USB_MUX_MODE_USB). */
	usb-mux-cb0-hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;			/* GPIO 46 */
		output-high;
		line-name = "usb-mux-cb0";
	};

	usb-mux-cb1-hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;			/* GPIO 45 */
		output-low;
		line-name = "usb-mux-cb1";
	};
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_pins>;

	interrupts-extended = <&wakeupgen GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH
			       &omap4_pmx_core OMAP4_UART3_RX>;
};

/* notle: I2C buses 2, 3, 4 at 384 kHz (board-notle.c notle_i2c_init). */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;

	/* notle: omap4_pmic_init("twl6030", ...) on I2C1, IRQ SYS_1N. */
	twl: twl@48 {
		reg = <0x48>;
		#clock-cells = <1>;
		interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
		system-power-controller;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <400000>;
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	clock-frequency = <400000>;
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	clock-frequency = <400000>;
};

#include "twl6030.dtsi"
#include "twl6030_omap4.dtsi"

/* notle: notle_vaux1, the eMMC's supply, 2.9 V and always on. */
&vaux1 {
	regulator-min-microvolt = <2900000>;
	regulator-max-microvolt = <2900000>;
	regulator-always-on;
};

/* notle: musb_board_data, UTMI, peripheral (no CONFIG_USB_OTG). */
&usb_otg_hs {
	pinctrl-names = "default";
	pinctrl-0 = <&usb_otg_hs_pins>;

	interface-type = <1>;
	mode = <2>;
	power = <50>;
};

&twl_usb_comparator {
	usb-supply = <&vusb>;
};

/*
 * The display subsystem's bus module stays out of mainline's hands: probed,
 * ti-sysc would reset and idle it, and the bootloader's running display
 * would go dark. Its clocks and power domain are held by the framebuffer
 * above (and pd_ignore_unused on the command line).
 */
&{/ocp/target-module@58000000} {
	status = "disabled";
};

/* Every MMC controller off; the full image turns on MMC2 and MMC5. */
&mmc1 {
	status = "disabled";
};

&mmc2 {
	status = "disabled";
};

&mmc3 {
	status = "disabled";
};

&mmc4 {
	status = "disabled";
};

&mmc5 {
	status = "disabled";
};
