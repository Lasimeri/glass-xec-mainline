# Google Glass XE-C (OMAP4430, "notle"): fragment on top of omap2plus_defconfig.
# SPDX-License-Identifier: GPL-2.0-only OR MIT

# Booted by Glass's Android bootloader (u-boot based, ATAGs only): the DTB is
# appended to zImage and the bootloader's ATAG_MEM (2 GB on XE-C), ATAG_CMDLINE
# (the boot.img cmdline) and ATAG_INITRD2 are folded into it.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y

# 2 GB on a 32-bit Cortex-A9: lowmem 760 MB with the 3G/1G split, rest highmem.
CONFIG_HIGHMEM=y
CONFIG_VMSPLIT_3G=y

# Only the OMAP4 family (smaller Image: the bootloader's ramdisk sits 16 MB
# above the kernel's load address).
CONFIG_ARCH_OMAP4=y
# CONFIG_ARCH_OMAP3 is not set
# CONFIG_SOC_AM33XX is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_TI81XX is not set
# CONFIG_ARCH_OMAP2 is not set

# Lifeline 1: the eMMC (MMC2, 8-bit) and filesystems.
CONFIG_MMC_OMAP_HS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Lifeline 2: TWL6030 PMIC (I2C1) and its regulators, built in. TWL6040 (the
# audio codec, I2C1, IRQ SYS_2N) is a bool option.
CONFIG_TWL4030_CORE=y
CONFIG_REGULATOR_TWL4030=y
CONFIG_TWL6030_USB=y
CONFIG_TWL6040_CORE=y

# Lifeline 3: USB device mode on the MUSB OTG port, configured from the
# initramfs through configfs: network (NCM, ECM, RNDIS) and a serial console.
# The OMAP MUSB glue depends on USB (omap2plus_defconfig has it =m), and
# TWL6030_USB on the OMAP USB2 PHY: all built in.
CONFIG_USB=y
CONFIG_OMAP_USB2=y
CONFIG_OMAP_CONTROL_PHY=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_NOP_USB_XCEIV=y

# Lifeline 4: crash logs that survive a warm reset (ramoops in the DTS).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=10

# xz: the smallest zImage (the boot and recovery partitions are about 6 MB).
CONFIG_KERNEL_XZ=y

# The camera button (gpio_wk30).
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_EVDEV=y

# Everything the full image drives is built in: no modules ship, and
# firmware loads from the embedded initramfs at probe time.
# Wi-Fi: BCM4330 on MMC5 (SDIO), brcmfmac, power sequence by GPIO.
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_PWRSEQ_SIMPLE=y
# The BCM4330's 32 kHz sleep clock: TWL6030 CLK32KG (notle: always on).
CONFIG_CLK_TWL=y
# Bluetooth: the BCM4330's HCI on a UART (serdev), PAN (BNEP) and HID.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_UHID=y
# Battery gauge, touchpad, IMU.
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_IIO=y
CONFIG_INV_MPU6050_I2C=y

# A framebuffer console for the display work (simple-framebuffer if the
# bootloader leaves the panel lit); the notle panel has no mainline driver.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_6x10=y

# Diagnostics for the first boots (glass-collect reads these).
CONFIG_I2C_CHARDEV=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# The OMAP watchdog driver stops a watchdog the bootloader may have armed
# when it probes (omap_wdt_disable unless early_enable): kept.
CONFIG_WATCHDOG=y
CONFIG_OMAP_WATCHDOG=y

# Size: the stock boot.img is 5,611,520 bytes, the only proven bound on the
# boot and recovery partitions; zImage + initramfs + DTB stay under it.
# Built for size, and nothing Glass has no hardware or use for.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_IP_PNP is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_MTD is not set
# CONFIG_EXT2_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_ATA is not set
# CONFIG_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_IPV6 is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NETFILTER is not set
# CONFIG_ETHERNET is not set
# CONFIG_FTRACE is not set
# CONFIG_SPI is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_CRYPTO_LZO is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_RD_XZ=y
# CONFIG_AUDIT is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_CGROUPS is not set
# CONFIG_SECURITY is not set
# CONFIG_SLUB_DEBUG is not set
