#!/bin/sh
# rcS-rootfs: the full system's start. The initramfs moved /dev, /run, /proc
# and /sys here; the rest is mounted, the filesystem grows to fill userdata
# once, then the USB link (shared with the initramfs), D-Bus (for BlueZ) and
# Wi-Fi when a network is configured (glass-wifi add SSID PASSPHRASE).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
log() { echo "glass-rootfs: $*" > /dev/kmsg; echo "$*" >> /run/glass/rcS.log; }
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
# /dev: the initramfs moves its own here; if that did not happen (a kernel
# without devtmpfs and an older initramfs), fill one now, or dropbear dies
# at the first connection for want of /dev/urandom.
if [ ! -c /dev/urandom ]; then
    mount -t devtmpfs devtmpfs /dev 2> /dev/null || mount -t tmpfs -o mode=755 tmpfs /dev
    echo /sbin/mdev > /proc/sys/kernel/hotplug
    mdev -s
fi
mkdir -p /run/glass /run/dbus /var/lib/misc /tmp /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug 2> /dev/null
mount -t configfs configfs /sys/kernel/config 2> /dev/null
mount -t pstore pstore /sys/fs/pstore 2> /dev/null
hostname glass
# Kernel messages off the serial console except alerts (console level 1);
# all still go to dmesg. At level 7 every warning went out the UART at
# 115200 baud in printk, a few ms each with the CPU busy-waiting: aplay's
# newer alsa-lib trips "unknown ioctl" (the time64 SYNC_PTR, 0xc0884123, a
# 3.4 kernel lacks) twice a period, about 40 lines a second, and the stream
# lost frames to it (2026-10-07).
echo "1 4 1 7" > /proc/sys/kernel/printk
log "rootfs up"

# The image is written smaller than the partition: grow it once (online).
if [ ! -f /etc/glass/resized ]; then
    dev=$(awk '$2 == "/" && $1 ~ /^\/dev\// { print $1 }' /proc/mounts | tail -n 1)
    if [ -n "$dev" ] && resize2fs "$dev" >> /run/glass/rcS.log 2>&1; then
        touch /etc/glass/resized
        log "filesystem grown to the whole of $dev"
    fi
fi

/etc/glass/rcS

# D-Bus and bluetoothd start with glass-pan, not here.
if grep -q '^network=' /etc/wpa_supplicant/wpa_supplicant.conf 2> /dev/null; then
    /usr/sbin/glass-wifi up > /dev/null 2>&1 &
fi

# Tailscale, when installed (apk add tailscale): the Glass on the user's
# tailnet as "glass", reachable from the desktop on any network, the phone's
# hotspot included (its NAT turns away connections from the home network).
# The login is kept in /var/lib/tailscale; DNS is left alone (--accept-dns
# false was given at the login). Log: /run/glass/tailscaled.log.
if [ -x /usr/sbin/tailscaled ]; then
    mkdir -p /var/lib/tailscale /run/tailscale
    setsid /usr/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state \
        --socket=/run/tailscale/tailscaled.sock > /run/glass/tailscaled.log 2>&1 < /dev/null &
    log "tailscaled started"
fi
exit 0
