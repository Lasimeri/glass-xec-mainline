#!/bin/sh
# glass-wifi: the BCM4330 (2.4 GHz b/g/n): brcmfmac on the mainline kernel,
# Google's bcmdhd on the stock kernel (its firmware from /lib/firmware/glass).
#   glass-wifi add SSID [PASSPHRASE]  store a WPA2 network. Without the
#                                     passphrase it is asked for, echo off:
#                                     it goes into no history and no log,
#                                     and only the derived 256-bit key is
#                                     kept (/etc/wpa_supplicant, root only)
#   glass-wifi forget SSID            drop a stored network
#   glass-wifi priority SSID N        join it before networks with a lower N
#                                     when several are in range (default 0)
#   glass-wifi static SSID ADDR/LEN GATEWAY [DNS]
#                                     a fixed address on that network, no
#                                     DHCP there (home: 192.168.0.80/24, the
#                                     user's choice 2026-10-07); SSID off
#                                     for DHCP again; alone, the list
#   glass-wifi use SSID | auto        join that network now (until "auto" or
#                                     a reboot), or choose by priority again
#   glass-wifi up | down | scan | status | list
c=/etc/wpa_supplicant/wpa_supplicant.conf
die() { echo "glass-wifi: $*" >&2; exit 1; }

# Google's driver reads its firmware and calibration from paths given as
# module parameters (empty: its compiled-in Android paths).
radio() {
    if [ -d /sys/module/bcmdhd ]; then
        f=/lib/firmware/glass
        [ -f $f/fw_bcmdhd.bin ] || die "no $f/fw_bcmdhd.bin (Google's Wi-Fi firmware, from the XE24 system image)"
        [ -f $f/bcmdhd.cal ] || die "no $f/bcmdhd.cal"
        echo $f/fw_bcmdhd.bin > /sys/module/bcmdhd/parameters/firmware_path
        echo $f/bcmdhd.cal > /sys/module/bcmdhd/parameters/nvram_path
    fi
    # The MAC is the radio's own (bcmdhd refuses a new one: the interface
    # will not come up again after a change, seen 2026-10-07); the desktop
    # finds the Glass by it when the address changes (scripts/glass).
    ip link set wlan0 up || die "wlan0 did not come up (dmesg | grep -i -e dhd -e brcmf)"
}
conf() {
    mkdir -p /etc/wpa_supplicant
    [ -f "$c" ] || printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n' > "$c"
    chmod 600 "$c"
}
supplicant() {
    conf
    [ -S /run/wpa_supplicant/wlan0 ] && return 0
    radio
    wpa_supplicant -B -i wlan0 -c "$c" -P /run/wpa_supplicant.pid || die "wpa_supplicant did not start"
}

# Fixed addresses by network (glass-wifi static), a line each: SSID, ADDR/LEN,
# gateway, DNS, tab-separated (SSIDs may hold spaces).
st=/etc/glass/wifi-static
dhcp_running() { [ -f /run/udhcpc.wlan0.pid ] && kill -0 "$(cat /run/udhcpc.wlan0.pid)" 2> /dev/null; }
# The address for the network just joined (SSID, 1 if it is another network
# than before): the fixed one listed for it, DHCP stopped; else DHCP, started
# if it is not running (the router learns the name "glass"), or a new lease
# asked for when the network changed (USR2 releases, USR1 starts again).
address() {
    set -- "$1" "$2" $( [ -f "$st" ] && awk -F '\t' -v s="$1" '$1 == s { print $2, $3, $4; exit }' "$st" )
    if [ -n "${3:-}" ]; then
        if dhcp_running; then kill "$(cat /run/udhcpc.wlan0.pid)" 2> /dev/null; fi
        rm -f /run/udhcpc.wlan0.pid
        if ! ip -4 addr show wlan0 | grep -q "inet $3 "; then
            ip -4 addr flush dev wlan0
            ip addr add "$3" brd + dev wlan0
        fi
        ip route replace default via "$4" dev wlan0
        echo "nameserver ${5:-$4}" > /etc/resolv.conf
        echo "glass-wifi: $(date +%T) on $1 at $3 (fixed)" >> /run/glass/rcS.log
    elif ! dhcp_running; then
        ip -4 addr flush dev wlan0   # a fixed address from another network goes
        udhcpc -b -i wlan0 -p /run/udhcpc.wlan0.pid -x hostname:glass -t 5 -T 3 > /dev/null 2>&1
        echo "glass-wifi: $(date +%T) on $1, address by DHCP" >> /run/glass/rcS.log
    elif [ "$2" = 1 ]; then
        p=$(cat /run/udhcpc.wlan0.pid)
        kill -USR2 "$p" 2> /dev/null; sleep 1; kill -USR1 "$p" 2> /dev/null
        echo "glass-wifi: $(date +%T) on $1 (another network): new DHCP lease asked for" >> /run/glass/rcS.log
    fi
    clock
}

# The clock, once a boot: no battery-backed time survives a power-off, and
# TLS (Tailscale's login, apk's mirrors) refuses a date in 2000. Tried every
# 10 s for two minutes from the first address on, in the background, one
# loop at a time; /run/glass/clock-ok marks success.
clock() {
    [ -f /run/glass/clock-ok ] && return 0
    mkdir -p /run/glass
    (
        flock -n 8 || exit 0
        i=0
        while [ $i -lt 12 ]; do
            if ntpd -n -q -p pool.ntp.org > /dev/null 2>&1; then
                touch /run/glass/clock-ok
                echo "glass-wifi: $(date +%T) clock set" >> /run/glass/rcS.log
                exit 0
            fi
            sleep 10; i=$((i + 1))
        done
    ) 8> /run/glass/clock.lock < /dev/null > /dev/null 2>&1 &
}

case "${1:-}" in
    add)
        ssid=${2:-}
        [ -n "$ssid" ] || die "glass-wifi add SSID [PASSPHRASE]"
        pass=${3:-}
        if [ -z "$pass" ]; then
            printf 'passphrase for %s (not shown): ' "$ssid" >&2
            stty -echo 2> /dev/null
            read -r pass
            stty echo 2> /dev/null
            echo >&2
        fi
        [ ${#pass} -ge 8 ] && [ ${#pass} -le 63 ] || die "a WPA2 passphrase is 8 to 63 characters"
        conf
        # wpa_passphrase prints the network block with the derived key (on
        # stdin it wants a terminal: the passphrase goes as its argument, in
        # ps for the milliseconds it runs, root being the only user here);
        # the commented plain line is dropped.
        block=$(wpa_passphrase "$ssid" "$pass" | grep -v '#psk=') || die "wpa_passphrase failed"
        pass=
        "$0" forget "$ssid"   # stored again: the old block goes
        printf '%s\n' "$block" >> "$c"
        echo "glass-wifi: $ssid stored (derived key only); glass-wifi up"
        if [ -S /run/wpa_supplicant/wlan0 ]; then wpa_cli -i wlan0 reconfigure > /dev/null; fi
        ;;
    forget)
        [ -n "${2:-}" ] || die "glass-wifi forget SSID"
        [ -f "$c" ] || exit 0
        # The SSID compared as text, not as a pattern ("O+ Open" has a +).
        awk -v s="$2" '
            /^network=\{/ { blk = $0; inb = 1; keep = 1; next }
            inb { blk = blk "\n" $0; t = $0; sub(/^[ \t]+/, "", t); if (t == "ssid=\"" s "\"") keep = 0; if ($0 ~ /^\}/) { inb = 0; if (keep) print blk }; next }
            { print }' "$c" > "$c.new" && mv "$c.new" "$c" && chmod 600 "$c"
        if [ -S /run/wpa_supplicant/wlan0 ]; then wpa_cli -i wlan0 reconfigure > /dev/null; fi
        ;;
    priority)
        # With several stored networks in range the highest number is
        # joined (wpa_supplicant's priority; 0 when unset). The user ranks the
        # phone's hotspot (O+ Open, 20) above home (10), 2026-10-07.
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "glass-wifi priority SSID N"
        case "$3" in *[!0-9]*) die "glass-wifi priority SSID N (a whole number, 0 or more)" ;; esac
        [ -f "$c" ] || die "no networks stored (glass-wifi add)"
        grep -q "^[[:space:]]*ssid=\"$(printf '%s' "$2" | sed 's/[][\.*^$/]/\\&/g')\"" "$c" || die "$2 is not stored (glass-wifi list)"
        awk -v s="$2" -v p="$3" '
            /^network=\{/ { n = 0; inb = 1; mine = 0; l[++n] = $0; next }
            inb && /^\}/ { for (i = 1; i <= n; i++) if (!(mine && l[i] ~ /^[ \t]*priority=/)) print l[i]; if (mine) print "\tpriority=" p; print; inb = 0; next }
            inb { l[++n] = $0; t = $0; sub(/^[ \t]+/, "", t); if (t == "ssid=\"" s "\"") mine = 1; next }
            { print }' "$c" > "$c.new" && mv "$c.new" "$c" && chmod 600 "$c"
        echo "glass-wifi: $2 priority $3"
        if [ -S /run/wpa_supplicant/wlan0 ]; then wpa_cli -i wlan0 reconfigure > /dev/null; fi
        ;;
    up)
        supplicant
        # No power save: a sleeping client gets its packets in bursts at
        # each beacon and TCP stalls on them (the stream showed one frame
        # every two seconds, 2026-10-07); the cost is some battery.
        iw dev wlan0 set power_save off 2> /dev/null
        # The address follows the network joined: wpa_cli runs this script
        # on each connection (the wlan0 case below), which sets the fixed
        # address of a network listed with glass-wifi static, or asks DHCP
        # (a new lease at once when the network changed: udhcpc alone kept
        # the hotspot's address on the home network until its lease ran
        # out, 2026-10-07).
        if ! { [ -f /run/wpa_cli.pid ] && kill -0 "$(cat /run/wpa_cli.pid)" 2> /dev/null; }; then
            wpa_cli -i wlan0 -a "$0" -B -P /run/wpa_cli.pid > /dev/null 2>&1
        fi
        # Already joined (up run again, or joined before wpa_cli listened):
        # no event comes for it, so the address is set here.
        if wpa_cli -i wlan0 status 2> /dev/null | grep -q '^wpa_state=COMPLETED'; then
            "$0" wlan0 CONNECTED
        fi
        ;;
    wlan[0-9]*)
        # wpa_cli -a: "glass-wifi wlan0 CONNECTED|DISCONNECTED".
        [ "${2:-}" = CONNECTED ] || exit 0
        mkdir -p /run/glass
        ssid=$(wpa_cli -i "$1" status 2> /dev/null | sed -n 's/^ssid=//p')
        last=$(cat /run/glass/wifi-ssid 2> /dev/null || true)
        printf '%s\n' "$ssid" > /run/glass/wifi-ssid
        changed=0
        [ -n "$last" ] && [ "$ssid" != "$last" ] && changed=1
        address "$ssid" "$changed"
        ;;
    use)
        # glass-wifi use SSID   join that stored network now, the others set
        #                       aside until glass-wifi use auto or the next
        #                       boot (wpa_supplicant's select_network: not
        #                       saved to the file)
        # glass-wifi use auto   choose by priority again
        [ -n "${2:-}" ] || die "glass-wifi use SSID | auto"
        if [ "$2" = auto ]; then
            wpa_cli -i wlan0 reconfigure > /dev/null || die "wpa_supplicant refused"
            echo "glass-wifi: choosing by priority again"
            exit 0
        fi
        id=$(wpa_cli -i wlan0 list_networks | awk -F '\t' -v s="$2" 'NR > 1 && $2 == s { print $1; exit }')
        [ -n "$id" ] || die "$2 is not stored (glass-wifi list)"
        wpa_cli -i wlan0 select_network "$id" > /dev/null || die "wpa_supplicant refused"
        echo "glass-wifi: joining $2 (glass-wifi use auto to go back)"
        ;;
    static)
        # glass-wifi static                       the list
        # glass-wifi static SSID ADDR/LEN GW [DNS] a fixed address there
        # glass-wifi static SSID off               DHCP there again
        mkdir -p /etc/glass
        if [ -z "${2:-}" ]; then
            [ -f "$st" ] && tr '\t' ' ' < "$st"
            exit 0
        fi
        ssid=$2
        if [ "${3:-}" = off ]; then
            [ -f "$st" ] && awk -F '\t' -v s="$ssid" '$1 != s' "$st" > "$st.new" && mv "$st.new" "$st"
            echo "glass-wifi: $ssid by DHCP"
        else
            a=${3:-}; g=${4:-}; d=${5:-${4:-}}
            echo "$a" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' || die "glass-wifi static SSID ADDR/LEN GATEWAY [DNS] (e.g. 192.168.0.80/24 192.168.0.1)"
            echo "$g" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || die "the gateway is an address, e.g. 192.168.0.1"
            { [ -f "$st" ] && awk -F '\t' -v s="$ssid" '$1 != s' "$st"; printf '%s\t%s\t%s\t%s\n' "$ssid" "$a" "$g" "$d"; } > "$st.new" && mv "$st.new" "$st"
            echo "glass-wifi: $ssid at $a (gateway $g, DNS $d)"
        fi
        # Joined to that network now: the change applies at once.
        if [ "$(cat /run/glass/wifi-ssid 2> /dev/null)" = "$ssid" ]; then address "$ssid" 0; fi
        ;;
    down)
        [ -f /run/wpa_cli.pid ] && kill "$(cat /run/wpa_cli.pid)" 2> /dev/null
        [ -f /run/udhcpc.wlan0.pid ] && kill "$(cat /run/udhcpc.wlan0.pid)" 2> /dev/null
        [ -f /run/wpa_supplicant.pid ] && kill "$(cat /run/wpa_supplicant.pid)" 2> /dev/null
        ip link set wlan0 down
        ;;
    scan)
        supplicant
        wpa_cli -i wlan0 scan > /dev/null
        sleep 4
        wpa_cli -i wlan0 scan_results
        ;;
    status)
        [ -S /run/wpa_supplicant/wlan0 ] && wpa_cli -i wlan0 status | grep -E '^(ssid|bssid|freq|key_mgmt|wpa_state|ip_address)='
        ip -4 addr show wlan0 2> /dev/null | grep inet
        ;;
    list)
        [ -f "$c" ] && grep -E '^\s*ssid=' "$c" | sed 's/^\s*ssid=//'
        ;;
    *) echo "glass-wifi add SSID [PASSPHRASE] | forget SSID | priority SSID N | static [SSID ADDR/LEN GATEWAY [DNS] | SSID off] | use SSID|auto | up | down | scan | status | list" >&2; exit 1 ;;
esac
