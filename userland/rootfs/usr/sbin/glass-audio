#!/bin/sh
# glass-audio: the Glass's sound output (TWL6040 codec behind the OMAP4 ABE,
# ALSA card 0 "Notle"). Routes the ABE's Multimedia stream (hw:0,0) to one
# of the codec's outputs:
#   glass-audio route earphone|handsfree|headset [VOLUME%]
#                                  earphone is the bone conduction
#                                  transducer, the Glass's own speaker: the
#                                  stock audio HAL (audio.primary.glass_1.so)
#                                  drives only Earphone, and Headset for the
#                                  earbud, never Handsfree or Vibra
#   glass-audio volume PERCENT     the Glass's own output level, kept with the
#                                  route (the desktop's sink volume is a
#                                  separate control on top of it)
#   glass-audio jack               "connected h2w|usb_audio" (exit 0) when an
#                                  earbud or headset is plugged in, else
#                                  "none" (exit 1)
#   glass-audio off
#   glass-audio test               a tone on each output in turn, low to high
#                                  pitch: earphone 440 Hz, handsfree 660 Hz,
#                                  headset 880 Hz
#   glass-audio delay [remote] [MS]
#                                  how far the sound runs behind the
#                                  desktop, kept here on the Glass: on the
#                                  home network (/etc/glass/audio-delay,
#                                  default 150) or over the tailnet
#                                  (audio-delay-remote, default 400: the
#                                  picture is held longer there); a playing
#                                  session follows within 2 s
#   glass-audio play [opus]        s16le 32 kHz mono on stdin (or Opus in
#                                  MPEG-TS over the tailnet) to the ABE's
#                                  Multimedia stream, that delay behind
#                                  (glass-play); to the kept route, or the
#                                  headset outputs while an earbud is in
# The route chosen last is kept in /etc/glass/audio-route.
set -u
conf=/etc/glass/audio-route
delay=/etc/glass/audio-delay
delay_remote=/etc/glass/audio-delay-remote
# The stream's sample rate: 32 kHz, all the bone conduction speaker
# reproduces (the user, 2026-10-07); a third less to carry than 48 kHz.
rate=32000
mix() { amixer -q -c 0 cset "name=$1" "$2" > /dev/null 2>&1 || echo "glass-audio: $1 = $2 refused" >&2; }
common() {
    mix 'DL1 Mixer Multimedia' on
    mix 'DL1 Media Playback Volume' 120
    # DL1 Mixer reaches the PDM outputs only through the sidetone mixer
    # (the ABE's DAPM graph: DL1 Mixer -> Sidetone Mixer -> DL1 PDM).
    mix 'Sidetone Mixer Playback' on
    mix 'DL1 PDM Switch' on
    mix 'TWL6040 Power Mode' 'High-Performance'
}
quiet() {
    mix 'Earphone Playback Switch' off
    mix 'Handsfree Left Playback' Off
    mix 'Handsfree Right Playback' Off
    mix 'Headset Left Playback' Off
    mix 'Headset Right Playback' Off
    mix 'DL1 PDM_DL2 Switch' off
}
route() {   # OUTPUT PERCENT
    common
    quiet
    p=${2:-50}
    case "$1" in
        earphone)
            mix 'Earphone Playback Volume' $((15 * p / 100))
            mix 'Earphone Playback Switch' on ;;
        handsfree)
            mix 'DL1 PDM_DL2 Switch' on
            mix 'Handsfree Playback Volume' "$((29 * p / 100)),$((29 * p / 100))"
            mix 'Handsfree Left Playback' 'HF DAC'
            mix 'Handsfree Right Playback' 'HF DAC' ;;
        headset)
            mix 'Headset Playback Volume' "$((15 * p / 100)),$((15 * p / 100))"
            mix 'Headset Left Playback' 'HS DAC'
            mix 'Headset Right Playback' 'HS DAC' ;;
        *) echo "glass-audio route earphone|handsfree|headset [VOLUME%]" >&2; return 1 ;;
    esac
}
tone() {   # HZ SECONDS
    /usr/local/bin/ffmpeg -hide_banner -loglevel error -f lavfi -i "sine=frequency=$1:duration=$2:sample_rate=48000" \
        -ac 2 -f s16le - | aplay -q -D hw:0,0 -f S16_LE -r 48000 -c 2 -t raw
}
case "${1:-}" in
    route) route "${2:-}" "${3:-50}" && { mkdir -p /etc/glass; echo "$2 ${3:-50}" > "$conf"; } ;;
    jack)
        # An audio device on the Glass: the earbud on the micro-USB port
        # (switch usb_audio) or a wired headset (switch h2w).
        for s in h2w usb_audio; do
            [ "$(cat /sys/class/switch/$s/state 2> /dev/null)" != 0 ] && [ -e /sys/class/switch/$s/state ] && { echo "connected $s"; exit 0; }
        done
        echo none; exit 1 ;;
    volume)
        [ -f "$conf" ] || { echo "glass-audio: no route yet (glass-audio route ...)" >&2; exit 1; }
        set -- $(cat "$conf") "${2:-50}"
        route "$1" "$3" && echo "$1 $3" > "$conf" ;;
    delay)
        # glass-audio delay [MS]          on the home network (and USB)
        # glass-audio delay remote [MS]   over the tailnet (hotspot, away)
        f=$delay; d=150; shift
        if [ "${1:-}" = remote ]; then f=$delay_remote; d=400; shift; fi
        if [ -n "${1:-}" ]; then
            case "$1" in *[!0-9]*) echo "glass-audio delay [remote] MS (50 to 2000)" >&2; exit 1 ;; esac
            [ "$1" -ge 50 ] && [ "$1" -le 2000 ] || { echo "glass-audio delay [remote] MS (50 to 2000)" >&2; exit 1; }
            echo "$1" > "$f"
        fi
        echo "$(cat "$f" 2> /dev/null || echo $d) ms" ;;
    off) quiet; mix 'DL1 Mixer Multimedia' off ;;
    test)
        route earphone 50; tone 440 1.5; sleep 1
        route handsfree 50; tone 660 1.5; sleep 1
        route headset 50; tone 880 1.5
        quiet ;;
    play)
        # The route kept (default: the bone conduction transducer at 50%);
        # an earbud or headset plugged in takes the headset outputs at the
        # same level, and the sound moves back when it is unplugged.
        out() { if "$0" jack > /dev/null; then echo headset; else echo own; fi; }
        use() {
            set -- $(cat "$conf" 2> /dev/null) earphone 50
            if [ "$cur" = headset ]; then route headset "$2"; else route "$1" "$2"; fi
        }
        cur=$(out); use
        # stdin through a copy on fd 3: a non-interactive shell gives a
        # command started with & /dev/null instead, and busybox sh does so
        # even with <&0 (aplay then read nothing and ended at once: every
        # session was silent until 2026-10-07).
        # glass-play (tools/glass-play) holds the delay set here (glass-audio
        # delay) however the desktop's and the Glass's clocks drift; aplay
        # fell 650 ms behind in twenty minutes. aplay stays the fallback.
        [ -f "$delay" ] || echo 150 > "$delay"
        [ -f "$delay_remote" ] || echo 400 > "$delay_remote"
        # One session at a time: a session whose network went away (the
        # Glass moved between home and the hotspot) can still hold the
        # device, and every new one then failed "Resource busy".
        p=$(pidof glass-play aplay glass-opusdec)
        if [ -n "$p" ]; then
            kill $p 2> /dev/null; sleep 1
            p=$(pidof glass-play aplay glass-opusdec); [ -z "$p" ] || kill -9 $p 2> /dev/null
        fi
        exec 3<&0
        if [ "${2:-}" = opus ]; then
            # Over the tailnet the desktop sends Opus (48 kbit/s, not 768) in
            # MPEG-TS; ffmpeg decodes it under its own name (glass-opusdec, a
            # link) so the stream's decoder is never mistaken for it; the
            # delay is the remote one, the picture there being held longer.
            [ -e /usr/local/bin/glass-opusdec ] || ln -s ffmpeg /usr/local/bin/glass-opusdec
            /usr/local/bin/glass-opusdec -hide_banner -loglevel error -probesize 32 -analyzeduration 0 \
                -f mpegts -i pipe:0 -f s16le -ar $rate -ac 1 - <&3 | /usr/local/bin/glass-play -r $rate -f "$delay_remote" &
        elif [ -x /usr/local/bin/glass-play ]; then
            /usr/local/bin/glass-play -r $rate -f "$delay" <&3 &
        else
            aplay -q -D plughw:0,0 -f S16_LE -r $rate -c 1 -t raw --buffer-time="$(( $(cat "$delay") * 1000 ))" <&3 &
        fi
        a=$!
        while kill -0 $a 2> /dev/null; do
            sleep 2
            n=$(out)
            [ "$n" = "$cur" ] || { cur=$n; use; }
        done
        wait $a 2> /dev/null ;;
    *) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
