#!/bin/sh
# /init of the Glass XE-C initramfs (the mainline images and the stock-kernel
# fallback). Mounts the kernel filesystems, then either switches to the
# Alpine rootfs on the userdata partition (only when one is there, made by
# scripts/build-userland.sh, and the command line does not say glass.stay) or
# hands over to busybox init with this initramfs' own /etc/inittab.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
# The stock 3.4 kernel has no devtmpfs: busybox mdev fills /dev and
# handles hotplug.
if ! mount -t devtmpfs devtmpfs /dev 2> /dev/null; then
    # On a tmpfs, so that it is a mount: the switch to the rootfs moves
    # /dev there (mount --move), which works for a mount only; a plain
    # directory left the rootfs with three device nodes and no
    # /dev/urandom, and its ssh server died on every connection
    # (2026-10-07).
    mount -t tmpfs -o mode=755 tmpfs /dev
    echo /sbin/mdev > /proc/sys/kernel/hotplug
    mdev -s
fi
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug 2> /dev/null
mount -t configfs configfs /sys/kernel/config 2> /dev/null
mkdir -p /sys/fs/pstore && mount -t pstore pstore /sys/fs/pstore 2> /dev/null
mkdir -p /run/glass
log() { echo "glass-init: $*" > /dev/kmsg; echo "$*" >> /run/glass/init.log; }
log "initramfs up, kernel $(uname -r)"
hostname glass

# The display: the bootloader left the DISPC's graphics pipe scanning
# 0x80500000, which the mainline kernel now occupies. Point it at the
# console's framebuffer (the device tree's simple-framebuffer at
# 0x9c700000), set its format to xRGB (0x8, no alpha) and latch it (GOLCD2).
# Only on mainline with that node, and only when CM_DSS_DSS_CLKCTRL says the
# module is clocked (reading a gated DISPC aborts).
display_handoff() {
    [ -e /proc/device-tree/chosen/framebuffer@9c700000 ] || return 0
    command -v devmem2 > /dev/null || return 0
    rd() { devmem2 "$1" w 2> /dev/null | sed -n 's/^Value at address.*: //p'; }
    wr() { devmem2 "$1" w "$2" > /dev/null 2>&1; }
    st=$(rd 0x4a009120)
    if [ -z "$st" ] || [ $(( (st >> 16) & 3 )) -ne 0 ]; then
        log "display: DSS not clocked (CM_DSS_DSS_CLKCTRL $st), left alone"
        return 0
    fi
    a=$(rd 0x480410a0)
    c=$(rd 0x48041238)
    wr 0x48041080 0x9c700000
    wr 0x48041084 0x9c700000
    wr 0x480410a0 $(( (a & ~0x1e) | (0x8 << 1) ))
    wr 0x48041238 $(( c | 0x20 ))
    log "display: GFX_BA0/BA1 0x9c700000, attributes $a, control2 $c, ba0 now $(rd 0x48041080)"
}
display_handoff

# The userdata partition by its GPT name (PARTNAME in the block uevent).
userdata() {
    for u in /sys/class/block/*/uevent; do
        grep -qx 'PARTNAME=userdata' "$u" 2> /dev/null || continue
        d=${u%/uevent}
        echo "/dev/${d##*/}"
        return 0
    done
    return 1
}

# Staying in the initramfs: glass.stay on the command line, or the file
# /etc/glass-stay baked into a "stay" image (the bootloader passes its own
# command line, so the file is the way that always works): from there the
# rootfs can be mounted, inspected and repaired (scripts/glass rescue).
stay=0
case " $(cat /proc/cmdline) " in *" glass.stay "*) stay=1 ;; esac
[ -f /etc/glass-stay ] && stay=1
case "$stay" in
    1) log "staying in the initramfs (glass.stay)" ;;
    *)
        # The eMMC appears a few seconds into boot on the full image; the
        # safe image has no MMC controller and finds nothing.
        dev=""
        i=0
        while [ $i -lt 8 ]; do
            dev=$(userdata) && break
            sleep 1
            i=$((i + 1))
        done
        if [ -n "$dev" ]; then
            mkdir -p /newroot
            # Read-only and without journal replay, to look without writing.
            if mount -t ext4 -o ro,noload "$dev" /newroot 2> /dev/null; then
                # The marker, and the system behind it: a write that stopped
                # halfway (2026-10-07, the bootloader's) left a filesystem
                # with the marker but a broken ssh server, and this switched
                # into it. init, dropbear and the key directory must be there.
                if [ -f /newroot/etc/glass-rootfs ] && [ -x /newroot/sbin/init ] &&
                   [ -x /newroot/usr/sbin/dropbear ] && [ -f /newroot/root/.ssh/authorized_keys ]; then
                    umount /newroot
                    if mount -t ext4 -o rw "$dev" /newroot; then
                        log "switching to the rootfs on $dev"
                        umount /tmp 2> /dev/null
                        for m in /dev /run /proc /sys; do
                            mkdir -p "/newroot$m"
                            mount --move "$m" "/newroot$m"
                        done
                        exec switch_root /newroot /sbin/init
                    fi
                    log "mounting $dev read-write failed: staying"
                else
                    log "$dev holds no glass rootfs (no /etc/glass-rootfs): staying"
                    umount /newroot
                fi
            else
                log "$dev is not ext4 (Android userdata, or empty): staying"
            fi
        else
            log "no userdata partition (safe image, or eMMC not up): staying"
        fi
        ;;
esac
exec /sbin/init
