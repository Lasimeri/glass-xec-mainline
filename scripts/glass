#!/bin/bash
# glass: the one entry point for building, testing and flashing Glass XE-C.
#   glass fetch                 download and verify everything (scripts/fetch.sh)
#   glass build                 userland, kernel (initramfs and both DTBs built
#                               in), images (scripts/build-*.sh)
#   glass check                 static userland checks and out/SHA256SUMS
#   glass status                what fastboot, adb and the USB link see, then
#                               the running Glass and this desktop's side as
#                               a table (network, tailnet, battery, heat,
#                               display, sound, what runs, the stream)
#   glass update                the running Glass brought up to date with this
#                               checkout, nothing flashed: packages, scripts,
#                               tools rebuilt where changed, restarts; user
#                               settings kept (scripts/on-glass/update.sh)
#   glass setup-desktop         this desktop's side: picture, sound, tap and camera
#                               supervisors at login and started now, and what
#                               they need, each with its fix
#   glass root-boot             fastboot boot out/boot-xe24-adbroot.img: stock
#                               XE24 Android with root adb, in RAM only
#   glass backup [--with-userdata]
#                               every partition over root adb into
#                               backup/DATE/ (userdata and cache only on
#                               request), sizes checked, SHA256SUMS,
#                               partitions.txt
#   glass info                  what stock Android knows about the hardware,
#                               into backup/DATE/info/ (the DISPC state first)
#   glass test-boot safe|full|stock
#                               fastboot boot out/boot-V.img (RAM only), then
#                               wait for 172.16.42.1 or /dev/ttyACM*
#   glass flash-recovery safe|full|stock
#                               the image into recovery (stock boot stays), only
#                               with a backup and a known partition size
#   glass flash-rootfs          out/rootfs.img into userdata
#   glass flash-boot stock|full the image into boot: Linux starts by itself at
#                               power-on, no cable (stock Android's boot stays in
#                               your backup; recovery is untouched); only with a
#                               backup holding boot.img and its size
#   glass restore               Google's XE24 boot, recovery and system back,
#                               cache and userdata wiped
#   glass restore-partition DIR NAME
#                               one partition back from a backup directory
#   glass ssh [CMD...]          root on the Glass (GLASS_IP, the name glass, the
#                               last Wi-Fi address, or USB 172.16.42.1)
#   glass ip                    the Glass's Wi-Fi address, remembered for next time
#                               (when it answers from here)
#   glass reboot-test [N]       reboots the running Glass N times (default 1)
#                               and times everything that comes back by
#                               itself: ssh, Wi-Fi, clock, tailnet, display
#                               shell, stream, sound, volume, tap
#   glass audio [status | glass | stereo | auto on|off | toggle]
#                               where the desktop's sound and the voice go:
#                               glass (and back to the stereo by itself when
#                               the Glass leaves), stereo (and it stays),
#                               automatic switching on or off (off for
#                               development: nothing moves by itself)
#   glass unplug-test [N] [S]   the USB cable "unplugged" N times (default 1)
#                               for S seconds (40) from the Glass's side, and
#                               back: times every session's move to home
#                               Wi-Fi, then checks they stay there
#   glass addr                  the address the verbs would use now (Wi-Fi,
#                               USB or tailnet)
#   glass camera [WxH] [FPS] [KBIT/S]
#                               the Glass's camera in a window here: H.264
#                               from the Ducati's encoder, no sound (default
#                               960x540, half the camera's 1920x1080 video
#                               size, at 15/s and 768 kbit/s)
#   glass collect               glass-collect on the Glass into out/collect-DATE.tar
#   glass serial                the USB serial console (/dev/ttyACM*)
# Every write says what it will do and asks for a typed "yes" (or --yes).
# Only boot, recovery, system, cache and userdata are ever written; xloader,
# bootloader and fpga are refused outright; boot is written only by
# flash-boot, restore and restore-partition.
set -euo pipefail
top=$(cd "$(dirname "$0")/.." && pwd)
cd "$top"
# glass audio needs no address (it switches this desktop's sound): at once,
# before the lookup below (up to 5 s with the Glass away).
if [ "${1:-}" = audio ]; then shift; exec scripts/glass-audio.sh "${@:-status}"; fi

# The Glass's address: GLASS_IP; else the last Wi-Fi address seen
# (out/glass-ip, written by glass-wifi-copy and by `glass ip`), else the
# name "glass" when the router resolves it (the Glass announces it with a
# DHCP lease), each if it answers a ping; else the USB link if it answers;
# else its tailnet address; else the Glass by its MAC on this subnet; else
# USB.
given_ip=${GLASS_IP:-}   # set by the caller: a fixed path (glass camera follows the Glass otherwise)
GLASS_IP=${GLASS_IP:-}
if [ -z "$GLASS_IP" ]; then
    # The remembered address first (on home Wi-Fi a fixed one, glass-wifi
    # static), then the router's name; each only if it answers (the router
    # keeps naming an old lease after the Glass moved to a fixed address).
    if [ -s out/glass-ip ]; then
        last=$(head -n 1 out/glass-ip)
        ping -c 1 -W 1 "$last" > /dev/null 2>&1 && GLASS_IP=$last
    fi
    if [ -z "$GLASS_IP" ]; then
        n=$(getent ahostsv4 glass 2> /dev/null | awk 'NR == 1 { print $1 }' || true)
        if [ -n "$n" ] && ping -c 1 -W 1 "$n" > /dev/null 2>&1; then GLASS_IP=$n; fi
    fi
    # The last address went quiet: the USB link if it is there; else the
    # Glass on the tailnet (tailscaled on the Glass, named "glass"; the
    # phone's hotspot, anywhere else), the desktop's tailscale giving the
    # address, no DNS needed; else the Glass by its Wi-Fi MAC (out/glass-mac)
    # in the neighbour table after one round of pings over the desktop's own
    # subnet (about a second, 254 pings: last, as the supervisors ask every
    # few seconds while the Glass is away).
    usb=0
    [ -z "$GLASS_IP" ] && ping -c 1 -W 1 172.16.42.1 > /dev/null 2>&1 && usb=1
    if [ -z "$GLASS_IP" ] && [ $usb = 0 ] && command -v tailscale > /dev/null; then
        ts=$(tailscale ip -4 glass 2> /dev/null | head -n 1 || true)
        if [ -n "$ts" ] && ping -c 1 -W 2 "$ts" > /dev/null 2>&1; then GLASS_IP=$ts; fi
    fi
    if [ -z "$GLASS_IP" ] && [ $usb = 0 ] && [ -s out/glass-mac ]; then
        mac=$(head -n 1 out/glass-mac)
        net=$(ip -4 route get 1.1.1.1 2> /dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | cut -d. -f1-3)
        if [ -n "$net" ]; then
            for i in $(seq 1 254); do ping -c 1 -W 1 "$net.$i" > /dev/null 2>&1 & done
            wait
            found=$(ip neigh show | awk -v m="$mac" 'tolower($0) ~ m && $1 ~ /^[0-9.]+$/ { print $1; exit }')
            if [ -n "$found" ]; then
                GLASS_IP=$found
                echo "$found" > out/glass-ip
            fi
        fi
    fi
    [ -n "$GLASS_IP" ] || GLASS_IP=172.16.42.1
fi
ALLOW=(boot recovery system cache userdata)
FORBID=(xloader bootloader fpga efs bootconfig misc)
YES=0
WITH_USERDATA=0
RESTORE_CTX=0
args=()
for a in "$@"; do
    case "$a" in
        --yes) YES=1 ;;
        --with-userdata) WITH_USERDATA=1 ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]+"${args[@]}"}"

die() { echo "glass: $*" >&2; exit 1; }
say() { echo "glass: $*"; }
stamp() { date +%Y%m%d-%H%M%S; }
need() { command -v "$1" > /dev/null || die "$1 is not installed"; }

# A typed "yes" (or --yes) before any write.
confirm() {
    say "about to: $*"
    [ "$YES" = 1 ] && return 0
    local r
    read -r -p "glass: type yes to go on: " r
    [ "$r" = yes ] || die "not confirmed; nothing written"
}
# The same, but --yes does not count.
confirm_typed() {
    say "about to: $*"
    local r
    read -r -p "glass: type yes to go on: " r
    [ "$r" = yes ] || die "not confirmed; nothing written"
}

# Whether a partition may be written at all.
guard_part() {
    local p=$1 x
    for x in "${FORBID[@]}"; do
        [ "$p" = "$x" ] && die "refusing to write $p: never xloader, bootloader, fpga, efs, bootconfig or misc (a bad write there may brick the Glass or lose its per-device data)"
    done
    for x in "${ALLOW[@]}"; do
        [ "$p" = "$x" ] && return 0
    done
    die "refusing to write $p: only ${ALLOW[*]} are ever written"
}

# The only path to fastboot flash.
fb_flash() {   # PARTITION IMAGE
    local p=$1 img=$2
    guard_part "$p"
    [ "$p" = boot ] && [ "$RESTORE_CTX" != 1 ] &&
        die "refusing to write boot: only glass flash-boot, restore and restore-partition write it"
    [ -f "$img" ] || die "no $img"
    say "fastboot flash $p $img"
    local out rc=0
    out=$(fastboot flash "$p" "$img" 2>&1) || rc=$?
    echo "$out"
    [ $rc = 0 ] && return 0
    # platform-tools since about 2020 ask the bootloader for the partition's
    # size before writing a boot image, and Glass's answers "0x" (reported
    # on XE24: "Couldn't parse partition size '0x'"). flash:raw skips the
    # question and sends the boot image as it is; only for a boot image.
    if echo "$out" | grep -q "Couldn't parse partition size" && [ "$(head -c 8 "$img")" = 'ANDROID!' ]; then
        say "the bootloader gave no size for $p; fastboot flash:raw $p $img"
        fastboot flash:raw "$p" "$img"
        return
    fi
    return $rc
}

# adb with root, CR stripped (adbd before Android 5 answers through a pty).
adbsh() { adb shell "$@" | tr -d '\r'; }
need_root_adb() {
    need adb
    adb get-state > /dev/null 2>&1 || die "no adb device (glass root-boot first, then wait for Android)"
    # toolbox id (Android 4.4) has no -u: uid=0(root) ...
    is_root() { case "$(adbsh id 2> /dev/null)" in uid=0\(*) return 0 ;; esac; return 1; }
    if ! is_root; then
        adb root > /dev/null 2>&1 || true
        sleep 3
        adb wait-for-device
        is_root || die "adb is not root (boot out/boot-xe24-adbroot.img: glass root-boot)"
    fi
}

# The by-name directory of the eMMC's partitions.
byname_dir() {
    local d
    d=$(adbsh 'ls -d /dev/block/platform/*/by-name /dev/block/platform/*/*/by-name 2>/dev/null' | head -n 1)
    [ -n "$d" ] || die "no by-name directory under /dev/block/platform"
    echo "$d"
}

# A by-name link's target: readlink, else the arrow in ls -l.
resolve() {   # DIR NAME
    local t
    t=$(adbsh "readlink $1/$2" 2> /dev/null)
    case "$t" in
        /dev/*) echo "$t"; return 0 ;;
    esac
    adbsh "ls -l $1/$2" | sed -n 's/.*-> *//p'
}

# Whether adb exec-out works (adbd of Android 5 and later); otherwise copies
# go through /data/local/tmp and adb pull, binary-safe either way.
exec_out_ok() { [ "$(adb exec-out echo ok 2> /dev/null)" = ok ]; }

# The newest backup directory holding NAME.img.
newest_backup_with() {
    local d
    for d in $(ls -1d backup/*/ 2> /dev/null | sort -r); do
        [ -f "$d$1.img" ] && { echo "${d%/}"; return 0; }
    done
    return 1
}

# A partition's size in bytes: the newest backup's partitions.txt, else
# fastboot getvar.
part_size() {   # NAME
    local d s
    if d=$(newest_backup_with "$1") && [ -f "$d/partitions.txt" ]; then
        s=$(awk -v n="$1" '$1 == n { print $3 }' "$d/partitions.txt")
        [ -n "$s" ] && { echo "$s"; return 0; }
    fi
    # Glass's bootloader is reported to answer a bare "0x": that is no size.
    s=$(fastboot getvar "partition-size:$1" 2>&1 | sed -n "s/^partition-size:$1: *\(0x[0-9a-fA-F]\{1,\}\).*/\1/p")
    [ -n "$s" ] && { echo $((s)); return 0; }
    return 1
}
recovery_size() { part_size recovery; }

# The desktop's key for the Glass: GLASS_SSH_KEY, else the dedicated
# ~/.ssh/glass_ed25519 (made 2026-10-07, its public half baked into the
# images), else ssh's defaults. The Glass's host key is pinned in out/.
ssh_glass() {
    mkdir -p out
    local id=()
    local k=${GLASS_SSH_KEY:-$HOME/.ssh/glass_ed25519}
    [ -f "$k" ] && id=(-i "$k" -o IdentitiesOnly=yes)
    # Keepalives: a session to a Glass that went away (Wi-Fi, power) ends in
    # about 10 s instead of hanging, so long-lived readers reconnect.
    # One pinned host key for every address the Glass turns up at (home
    # Wi-Fi, USB, the tailnet, the hotspot): HostKeyAlias checks each against
    # the entry "glass", so a new address is never trusted on first sight.
    ssh "${id[@]}" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$top/out/known_hosts_glass" \
        -o HostKeyAlias=glass \
        -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "root@$GLASS_IP" "$@"
}

image_for() {   # safe|full|stock
    case "${1:-}" in
        safe | full) echo "out/boot-$1.img" ;;
        stock) echo out/boot-stock-kernel.img ;;
        *) die "which image: safe, full or stock" ;;
    esac
}

verb=${1:-help}
shift || true
case "$verb" in
    fetch) exec scripts/fetch.sh ;;

    build)
        scripts/build-userland.sh all
        GLASS_INITRAMFS=$top/build/initramfs JOBS=${JOBS:-4} scripts/build-kernel.sh \
            zImage ti/omap/omap4-glass-xec.dtb ti/omap/omap4-glass-xec-safe.dtb
        scripts/build-images.sh
        ;;

    check)
        scripts/check-userland.sh build/initramfs build/rootfs
        (cd out && sha256sum -c SHA256SUMS)
        ;;

    status)
        if command -v fastboot > /dev/null; then echo "fastboot:"; fastboot devices; fi
        if command -v adb > /dev/null; then adb devices | sed 1d | sed '/^$/d; s/^/adb: /'; fi
        if ping -c 1 -W 1 "$GLASS_IP" > /dev/null 2>&1; then say "$GLASS_IP answers (glass ssh)"; else say "$GLASS_IP does not answer"; fi
        ls /dev/ttyACM* 2> /dev/null | sed 's/^/serial: /' || true
        # The running Glass and this desktop's side, as a table.
        if rows=$(ssh_glass 'sh -s' < scripts/on-glass/status.sh 2> /dev/null); then
            echo
            echo "Glass ($GLASS_IP)"
            echo "$rows" | awk -F '\t' '{ printf "  %-12s %s\n", $1, $2 }'
            echo
            echo "Desktop"
            r=${XDG_RUNTIME_DIR:-/tmp}
            last=$(grep 'glass-fb: .*frames/s shown' "$r/glass-viewd.log" 2> /dev/null | tail -n 1 |
                sed -n 's/.*glass-fb: \([0-9.]*\) frames\/s shown.*, \([0-9]*\) late slots.*/\1 frames\/s, \2 late slots in the last 5 s/p')
            printf "  %-12s %s\n" stream "${last:-no report yet}"
            n=0; sup=""
            for s in glass-viewd glass-audio glass-tap glass-camera; do
                sup="$sup${sup:+, }$s $(systemctl --user is-active "$s.service" 2> /dev/null)"
                [ "$(systemctl --user is-enabled "$s.service" 2> /dev/null)" = enabled ] && n=$((n + 1))
            done
            printf "  %-12s %s\n" services "$sup"
            printf "  %-12s %s\n" at-login "$n of 4 enabled (glass setup-desktop sets them up)"
        fi
        ;;

    update)
        # The running Glass brought up to date with this checkout, nothing
        # flashed: scripts/on-glass/update.sh does the work there (packages,
        # files, tools rebuilt on the Glass where their source changed,
        # restarts of what changed; user settings kept). Binaries it builds
        # are copied back to out/ for the next rootfs build.
        ssh_glass true < /dev/null > /dev/null 2>&1 || die "the Glass does not answer at $GLASS_IP"
        say "updating the Glass at $GLASS_IP"
        stage=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/glass-update.XXXXXX")
        trap 'rm -rf "$stage"' EXIT
        cp -a userland/initramfs/. "$stage/"
        cp -a userland/rootfs/. "$stage/"
        mkdir -p "$stage/usr/local/src" "$stage/usr/share/glass"
        for t in glass-fb glass-tap glass-console glass-play glass-camera glass-fbgrab; do cp "tools/$t/$t.c" "$stage/usr/local/src/"; done
        cp -a tools/glass-camera/omx "$stage/usr/local/src/"   # the OMX headers glass-camera is built with
        font=/usr/share/kbd/consolefonts/Lat2-Terminus16.psfu.gz
        if [ -f "$font" ]; then gzip -dc "$font" > "$stage/usr/share/glass/console.psf"; else say "no $font (kbd): the console font is not sent"; fi
        cp scripts/on-glass/update.sh "$stage/.update.sh"
        tar -C "$stage" -cf - . | ssh_glass 'rm -rf /tmp/glass-update && mkdir -p /tmp/glass-update && tar -C /tmp/glass-update -xf -' ||
            die "the files did not reach the Glass"
        rc=0
        report=$(ssh_glass 'sh /tmp/glass-update/.update.sh' < /dev/null) || rc=$?
        echo "$report" | grep -v '^BUILT:' || true
        for t in $(echo "$report" | sed -n 's/^BUILT://p'); do
            ssh_glass "cat /usr/local/bin/$t" < /dev/null > "out/$t.new" && mv "out/$t.new" "out/$t" && say "out/$t kept for the rootfs build"
        done
        [ $rc = 0 ] || die "the update stopped (above)"
        ;;

    setup-desktop)
        # This desktop's side, repeatable: the four supervisors (picture,
        # sound, tap, camera) as systemd user services: one copy each,
        # started with the graphical session, started again 5 s after any
        # exit (a camera window closed or crashed comes back while the Glass
        # is up); then what they need, each with its fix. One stopped for a
        # while: systemctl --user stop glass-camera (start to bring it back).
        u=$HOME/.config/systemd/user
        mkdir -p "$u"
        unit() {   # SERVICE DESCRIPTION
            printf '[Unit]\nDescription=%s\nAfter=graphical-session.target\nPartOf=graphical-session.target\n\n[Service]\nExecStart=%s\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=graphical-session.target\n' \
                "$2" "$top/scripts/$1.sh" > "$u/$1.service"
        }
        unit glass-viewd "Google Glass: the desktop's monitor and a shell on the Glass whenever it is up (glass-xec)"
        unit glass-audio "Google Glass: the desktop's sound on the Glass while it is on the network (glass-xec)"
        unit glass-tap "Google Glass: a tap on the touchpad toggles the voice mute (glass-xec)"
        unit glass-camera "Google Glass: the camera in its own window whenever the Glass is up (glass-xec)"
        say "services: $u/glass-viewd.service, glass-audio.service, glass-tap.service, glass-camera.service"
        # What these replace: the login autostart entries, and any supervisor
        # running outside its service (from an autostart entry or a shell),
        # ended with its process group, so each runs once, under systemd.
        for s in glass-viewd glass-audio glass-tap glass-camerad; do rm -f "$HOME/.config/autostart/$s.desktop"; done
        for s in glass-viewd glass-audio glass-tap glass-camerad glass-camera; do
            for p in $(pgrep -f "scripts/$s[.]sh$"); do
                grep -q "/$s\.service" "/proc/$p/cgroup" 2> /dev/null && continue
                g=$(ps -o pgid= -p "$p" | tr -d ' ')
                if [ -n "$g" ] && [ "$g" = "$p" ]; then kill -- "-$g" 2> /dev/null || true; else kill "$p" 2> /dev/null || true; fi
            done
        done
        systemctl --user daemon-reload
        systemctl --user enable --now glass-viewd.service glass-audio.service glass-tap.service glass-camera.service 2>&1 | grep -v "^Created symlink" >&2 || true
        # The sound's switches in the application launcher (and KRunner:
        # type "glass audio"); a keyboard shortcut can be given to any of
        # them in System Settings, Shortcuts.
        l=$HOME/.local/share/applications
        mkdir -p "$l"
        launcher() {   # FILE NAME ARGS COMMENT
            printf '[Desktop Entry]\nType=Application\nName=%s\nComment=%s\nExec=%s audio %s\nIcon=audio-volume-high\nTerminal=false\nCategories=AudioVideo;Audio;\n' \
                "$2" "$4" "$top/scripts/glass" "$3" > "$l/$1.desktop"
        }
        launcher glass-audio-toggle "Glass audio: automatic switching on/off" toggle "Turns automatic sound switching to the Google Glass on or off (off for development: nothing moves by itself)"
        launcher glass-audio-glass "Glass audio: sound to the Glass" glass "The desktop's sound and the voice to the Google Glass, back to the stereo by itself when it leaves"
        launcher glass-audio-stereo "Glass audio: sound to the stereo" stereo "The desktop's sound and the voice to the stereo, and it stays there"
        say "launchers: $l/glass-audio-toggle.desktop, glass-audio-glass.desktop, glass-audio-stereo.desktop"
        for s in glass-viewd glass-audio glass-tap glass-camera; do
            say "$s: $(systemctl --user is-active "$s.service")"
        done
        [ -f "$HOME/.ssh/glass_ed25519" ] || say "missing ~/.ssh/glass_ed25519, the key the Glass trusts: ssh-keygen -t ed25519 -N '' -f ~/.ssh/glass_ed25519, then rebuild the images (or add the .pub to the Glass's /root/.ssh/authorized_keys)"
        [ -x "${DESK:-$HOME/deskpilot/target/release/desk}" ] || say "missing the desk tool (screen capture): cargo build --release in ~/deskpilot"
        command -v gst-launch-1.0 > /dev/null || say "missing GStreamer: install gstreamer, gst-plugin-pipewire, gst-plugins-bad"
        command -v tailscale > /dev/null || say "no tailscale here: the Glass is then reachable only on this network and by USB"
        [ -x "$HOME/tts079/ptt079" ] || say "no ~/tts079/ptt079: a tap on the Glass has no mute to toggle"
        ;;

    root-boot)
        need fastboot
        # Google's own rooted boot.img for the software the Glass runs, when
        # fetch.sh could get it (XE21, XE22); else the patched XE24 one.
        img=${GLASS_ROOT_IMG:-}
        if [ -z "$img" ]; then
            for c in dl/boot-rooted-xe21.img out/boot-xe24-adbroot.img; do [ -f "$c" ] && { img=$c; break; }; done
        fi
        [ -n "$img" ] && [ -f "$img" ] || die "no root image: glass fetch (dl/boot-rooted-xe21.img) or glass build (out/boot-xe24-adbroot.img)"
        say "fastboot boot $img (RAM only, nothing written)"
        fastboot boot "$img"
        say "wait for Android, then: glass backup; glass info"
        say "if Android comes up but adb is not root (adb shell id), the bootloader booted the flashed boot instead of this image: RAM boot is unsupported, stop and send back the fastboot output"
        ;;

    backup)
        need_root_adb
        dir=$(byname_dir)
        b=backup/$(stamp)
        mkdir -p "$b"
        say "partitions in $dir, into $b"
        eo=0
        exec_out_ok && eo=1
        [ $eo = 1 ] || say "adb exec-out unsupported here: copying through /data/local/tmp"
        : > "$b/partitions.txt"
        for name in $(adbsh "ls $dir"); do
            case "$name" in
                userdata | cache) [ "$WITH_USERDATA" = 1 ] || { say "skip $name (--with-userdata to include)"; continue; } ;;
            esac
            dev=$(resolve "$dir" "$name")
            [ -n "$dev" ] || die "cannot resolve $dir/$name"
            sectors=$(adbsh "cat /sys/class/block/${dev##*/}/size")
            want=$((sectors * 512))
            say "$name ($dev, $want bytes)"
            if [ $eo = 1 ]; then
                adb exec-out "dd if=$dev bs=1048576 2>/dev/null" > "$b/$name.img"
            else
                adbsh "mkdir -p /data/local/tmp/glass && dd if=$dev of=/data/local/tmp/glass/$name.img bs=1048576 2>/dev/null"
                adb pull "/data/local/tmp/glass/$name.img" "$b/$name.img" > /dev/null
                adbsh "rm /data/local/tmp/glass/$name.img"
            fi
            got=$(stat -c %s "$b/$name.img")
            [ "$got" = "$want" ] || die "$name: copied $got bytes, the partition has $want; backup incomplete in $b"
            printf '%s %s %s\n' "$name" "$dev" "$want" >> "$b/partitions.txt"
        done
        (cd "$b" && sha256sum ./*.img > SHA256SUMS)
        say "backup done: $b ($(wc -l < "$b/partitions.txt") partitions, sizes match, SHA256SUMS written)"
        ;;

    info)
        need_root_adb
        i=backup/$(stamp)/info
        mkdir -p "$i"
        dir=$(byname_dir)
        grab() {   # FILE COMMAND
            local f=$1
            shift
            if ! adbsh "$*" > "$i/$f" 2>&1; then echo "glass info: $f failed" >> "$i/errors.txt"; fi
        }
        # Mounting an already-mounted debugfs fails harmlessly (no grep in 4.4's toolbox).
        adbsh 'mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null' > /dev/null 2>&1 || true
        grab getprop.txt getprop
        grab cmdline.txt cat /proc/cmdline
        grab iomem.txt cat /proc/iomem
        grab meminfo.txt cat /proc/meminfo
        grab cpuinfo.txt cat /proc/cpuinfo
        grab interrupts.txt cat /proc/interrupts
        grab dmesg.txt dmesg
        grab byname.txt ls -l "$dir"
        grab partitions.txt cat /proc/partitions
        grab partition-sizes.txt "for f in /sys/class/block/*/size; do echo \"\$f \$(cat \$f)\"; done"
        grab dss-dispc.txt cat /sys/kernel/debug/omapdss/dispc
        grab dss-debugfs.txt "for f in /sys/kernel/debug/omapdss/*; do echo \"== \$f\"; cat \$f; done"
        grab omapdss-sysfs.txt "for f in /sys/devices/platform/omapdss/* /sys/devices/platform/omapdss/*/* /sys/devices/platform/omapdss/*/*/*; do [ -f \$f ] && { echo \"== \$f\"; cat \$f; }; done"
        grab fb0.txt "for f in /sys/class/graphics/fb0/*; do [ -f \$f ] && { echo \"== \$f\"; cat \$f; }; done"
        grab omap-mux.txt "for f in /sys/kernel/debug/omap_mux/board/* /sys/kernel/debug/omap_mux/*; do [ -f \$f ] && { echo \"== \$f\"; cat \$f; }; done"
        grab gpio.txt cat /sys/kernel/debug/gpio
        grab regulators.txt "for f in /sys/kernel/debug/regulator/*; do echo \"== \$f\"; cat \$f 2>&1; done"
        grab regulators-sysfs.txt "for r in /sys/class/regulator/*; do echo \"== \$r \$(cat \$r/name) \$(cat \$r/microvolts 2>/dev/null) \$(cat \$r/state 2>/dev/null)\"; done"
        grab i2c-devices.txt "for d in /sys/bus/i2c/devices/*; do echo \"\$d \$(cat \$d/name 2>/dev/null)\"; done"
        if [ -n "$(adbsh 'command -v i2cdetect' 2> /dev/null)" ]; then
            grab i2cdetect.txt "for b in 0 1 2 3 4; do echo \"== i2c-\$b\"; i2cdetect -y -r \$b; done"
        fi
        say "info in $i$([ -f "$i/errors.txt" ] && echo " (some paths missing: $i/errors.txt)")"
        ;;

    test-boot)
        need fastboot
        img=$(image_for "${1:-}")
        [ -f "$img" ] || die "no $img (glass build)"
        rm -f out/known_hosts_glass   # a new boot, a new dropbear host key
        say "fastboot boot $img (RAM only, nothing written)"
        fastboot boot "$img"
        say "waiting up to 90 s for $GLASS_IP or /dev/ttyACM*"
        t=0
        while [ $t -lt 90 ]; do
            if ping -c 1 -W 1 "$GLASS_IP" > /dev/null 2>&1; then
                say "up: glass ssh; glass collect"
                exit 0
            fi
            if ls /dev/ttyACM* > /dev/null 2>&1; then
                say "USB serial is up ($(ls /dev/ttyACM* | tr '\n' ' ')): glass serial. No IP yet: is the new interface (ip -br link) up with DHCP?"
            fi
            sleep 2
            t=$((t + 3))
        done
        say "nothing after 90 s. It wrote nothing: power-cycle it. Send back: fastboot getvar all, dmesg | tail -n 60 on this desktop, a photo of the display."
        exit 1
        ;;

    flash-recovery)
        need fastboot
        img=$(image_for "${1:-}")
        [ -f "$img" ] || die "no $img (glass build)"
        newest_backup_with recovery > /dev/null || die "no backup holding recovery.img: glass root-boot, then glass backup, first"
        size=$(recovery_size) || die "the recovery partition's size is unknown (no partitions.txt, fastboot getvar partition-size:recovery unanswered): refusing"
        isz=$(stat -c %s "$img")
        [ "$isz" -le "$size" ] || die "$img is $isz bytes, recovery holds $size: refusing"
        confirm "write $img ($isz bytes) into recovery ($size bytes); stock boot stays as it is"
        fb_flash recovery "$img"
        say "written. To boot it: fastboot reboot recovery (the bootloader's support is unverified), or from Android adb reboot recovery; a button combination for recovery is unverified"
        ;;

    flash-boot)
        need fastboot
        img=$(image_for "${1:-}")
        [ -f "$img" ] || die "no $img (glass build)"
        newest_backup_with boot > /dev/null || die "no backup holding boot.img (your way back): glass backup first"
        size=$(part_size boot) || die "the boot partition's size is unknown: refusing"
        isz=$(stat -c %s "$img")
        [ "$isz" -le "$size" ] || die "$img is $isz bytes, boot holds $size: refusing"
        confirm_typed "write $img ($isz bytes) into boot ($size bytes): Linux starts by itself from now on; stock Android's boot is in $(newest_backup_with boot)/boot.img (glass restore-partition DIR boot puts it back; fastboot stays reachable by the buttons)"
        # From Linux on the Glass when it is up (the partition is the image's
        # bytes; dd then read back), else fastboot.
        if ssh_glass true < /dev/null > /dev/null 2>&1; then
            bd=$(ssh_glass 'for u in /sys/class/block/*/uevent; do grep -qx PARTNAME=boot "$u" && { d=${u%/uevent}; echo "/dev/${d##*/}"; break; }; done' < /dev/null | tr -d '\r')
            [ -n "$bd" ] || die "the Glass sees no boot partition"
            say "writing $img into $bd on the Glass over ssh"
            ssh_glass "dd of=$bd bs=1M conv=fsync 2>&1 | tail -n 1; sync" < "$img"
            got=$(ssh_glass "dd if=$bd bs=1M count=$(( (isz + 1048575) / 1048576 )) 2> /dev/null | head -c $isz | sha256sum" < /dev/null | awk '{ print $1 }')
            [ "$got" = "$(sha256sum "$img" | awk '{ print $1 }')" ] || die "read-back of $bd does not match $img"
            say "written and read back; glass ssh reboot starts it"
        else
            RESTORE_CTX=1
            fb_flash boot "$img"
            say "written: fastboot reboot starts it"
        fi
        rm -f out/known_hosts_glass   # a new system makes a new host key
        ;;

    flash-rootfs)
        [ -f out/rootfs.img ] || die "no out/rootfs.img (glass build)"
        # The bootloader refuses sparse images ("Sparsed Write") and wrote a
        # 392 MB raw one for twelve minutes without finishing (2026-10-07),
        # so the image goes in from Linux on the Glass when it is up: the
        # raw image, compressed (mostly zeros), unpacked into the userdata
        # partition at the eMMC's own speed. Fastboot, raw, is the fallback.
        if ssh_glass true < /dev/null > /dev/null 2>&1; then
            rootdev=$(ssh_glass "awk '\$2 == \"/\" { print \$1 }' /proc/mounts | tail -n 1" < /dev/null | tr -d '\r')
            ud=$(ssh_glass 'for u in /sys/class/block/*/uevent; do grep -qx PARTNAME=userdata "$u" && { d=${u%/uevent}; echo "/dev/${d##*/}"; break; }; done' < /dev/null | tr -d '\r')
            [ -n "$ud" ] || die "the Glass sees no userdata partition (safe image?)"
            case "$rootdev" in
                "$ud") die "the Glass is running from $ud already: a running rootfs is not overwritten (boot the initramfs alone: cmdline glass.stay, or fastboot)" ;;
            esac
            confirm_typed "write out/rootfs.img into $ud on the Glass over ssh ($GLASS_IP), overwriting it"
            need simg2img
            [ -f out/rootfs.raw ] && [ out/rootfs.raw -nt out/rootfs.img ] || simg2img out/rootfs.img out/rootfs.raw
            say "writing $(stat -c %s out/rootfs.raw) bytes (compressed in flight) into $ud"
            gzip -1 -c out/rootfs.raw | ssh_glass "gunzip -c | dd of=$ud bs=4M conv=fsync 2>&1 | tail -n 1; sync"
            ssh_glass "mount -t ext4 -o ro,noload $ud /mnt 2> /dev/null && cat /mnt/etc/glass-rootfs; umount /mnt 2> /dev/null" < /dev/null | tr -d '\r' | grep -q "glass-xec rootfs" || die "the written partition does not read back as a glass rootfs"
            say "written and read back; reboot the Glass (glass ssh reboot) to switch to it"
        else
            need fastboot
            fastboot devices 2> /dev/null | grep -q . || die "neither ssh to the Glass ($GLASS_IP) nor fastboot: boot Linux or enter fastboot"
            confirm_typed "write out/rootfs.img (raw, through fastboot: slow on this bootloader) into userdata, overwriting it"
            need simg2img
            [ -f out/rootfs.raw ] && [ out/rootfs.raw -nt out/rootfs.img ] || simg2img out/rootfs.img out/rootfs.raw
            guard_part userdata
            say "fastboot -S 0 flash userdata out/rootfs.raw"
            fastboot -S 0 flash userdata out/rootfs.raw
            say "written: glass test-boot full switches to it"
        fi
        ;;

    restore)
        need fastboot
        z=dl/xe24/factory-xe24.zip
        [ -f "$z" ] || die "no $z (glass fetch)"
        for f in boot.img recovery.img system.img; do [ -f "dl/xe24/$f" ] || unzip -o -q "$z" "$f" -d dl/xe24; done
        confirm "flash Google's XE24 boot, recovery and system from dl/xe24, erase cache, wipe userdata"
        RESTORE_CTX=1
        fb_flash boot dl/xe24/boot.img
        fb_flash recovery dl/xe24/recovery.img
        fb_flash system dl/xe24/system.img
        fastboot erase cache
        fastboot format userdata 2> /dev/null || fastboot erase userdata
        say "stock XE24 restored: fastboot reboot"
        ;;

    restore-partition)
        need fastboot
        d=${1:?glass restore-partition DIR NAME}
        name=${2:?glass restore-partition DIR NAME}
        guard_part "$name"
        f=$d/$name.img
        [ -f "$f" ] || die "no $f"
        if [ -f "$d/SHA256SUMS" ]; then
            (cd "$d" && grep " \./$name\.img\$\| $name\.img\$" SHA256SUMS | sha256sum -c -) || die "$f does not match $d/SHA256SUMS"
        fi
        confirm "flash $f into $name"
        RESTORE_CTX=1
        fb_flash "$name" "$f"
        ;;

    ssh) ssh_glass "$@" ;;

    # The Glass's Wi-Fi address, asked over whatever link works, remembered
    # in out/glass-ip for the next run.
    ip)
        a=$(ssh_glass "ip -4 addr show wlan0 2> /dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p'" < /dev/null | tr -d '\r' | head -n 1)
        [ -n "$a" ] || die "the Glass has no Wi-Fi address (glass ssh glass-wifi status)"
        m=$(ssh_glass "cat /sys/class/net/wlan0/address" < /dev/null | tr -d '\r' | head -n 1)
        mkdir -p out
        # Remembered only when it answers from here: on the phone's hotspot
        # the Wi-Fi address is behind the phone and the tailnet is the way.
        if ping -c 1 -W 1 "$a" > /dev/null 2>&1; then echo "$a" > out/glass-ip; fi
        [ -n "$m" ] && echo "$m" > out/glass-mac
        echo "$a $m"
        ;;

    reboot-test)
        # Reboots the running Glass N times and times everything that comes
        # back by itself (scripts/glass-reboot-test.sh).
        exec scripts/glass-reboot-test.sh "${1:-1}"
        ;;

    camera)
        # The Glass's camera in its own window here (scripts/glass-camera.sh).
        GLASS_IP=$given_ip exec scripts/glass-camera.sh "$@"
        ;;

    unplug-test)
        # The USB cable unplugged from the Glass's side and back, timing
        # every session's move to home Wi-Fi (scripts/glass-unplug-test.sh).
        exec scripts/glass-unplug-test.sh "${1:-1}" "${2:-40}"
        ;;

    addr)
        # The address the other verbs would use now (the lookup above), for
        # scripts that open several connections and want one path for all.
        echo "$GLASS_IP"
        ;;

    collect)
        mkdir -p out
        o=out/collect-$(stamp).tar
        ssh_glass glass-collect > "$o"
        say "$o:"
        tar -tvf "$o"
        ;;

    serial)
        t=$(ls /dev/ttyACM* 2> /dev/null | head -n 1)
        [ -n "$t" ] || die "no /dev/ttyACM* (the safe and full images give one; the stock kernel's gadget is RNDIS only)"
        [ -r "$t" ] && [ -w "$t" ] || say "$t is not readable and writable for you: add yourself to its group ($(stat -c %G "$t"))"
        if command -v busybox > /dev/null && busybox --list | grep -qx microcom; then
            say "busybox microcom -s 115200 $t (leave: Ctrl-X)"
            exec busybox microcom -s 115200 "$t"
        elif command -v screen > /dev/null; then
            say "screen $t 115200 (leave: Ctrl-A then k)"
            exec screen "$t" 115200
        elif command -v picocom > /dev/null; then
            exec picocom -b 115200 "$t"
        else
            die "no busybox microcom, screen or picocom; any serial terminal at 115200 on $t works"
        fi
        ;;

    help | -h | --help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
    *) die "unknown verb $verb (glass help)" ;;
esac
